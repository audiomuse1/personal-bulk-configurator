# If publishing to npm public registry:
registry=https://registry.npmjs.org/

# If publishing to GitHub Packages instead, uncomment:
# @unionbase:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# If publishing to a private Verdaccio/Artifactory, uncomment:
# @unionbase:registry=https://your-registry.example.com/