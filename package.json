{
  "name": "@unionbase/bulk-configurator",
  "version": "2.1.0",
  "type": "module",
  "description": "Multi-product bulk order configurator web component for BigCommerce Cornerstone themes",
  "main": "dist/bulk-configurator.iife.js",
  "module": "dist/bulk-configurator.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/bulk-configurator.es.js",
      "require": "./dist/bulk-configurator.iife.js",
      "types": "./dist/types/index.d.ts"
    },
    "./iife": "./dist/bulk-configurator.iife.js",
    "./es": "./dist/bulk-configurator.es.js"
  },
  "files": [
    "dist/",
    "bigcommerce/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "terser": "^5.46.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/bulk-configurator.git"
  },
  "keywords": [
    "bigcommerce",
    "cornerstone",
    "bulk-order",
    "web-component",
    "lit",
    "configurator",
    "custom-printing"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": true
}
